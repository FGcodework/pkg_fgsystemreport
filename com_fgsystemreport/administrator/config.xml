<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset label="COM_FGSYSTEMREPORT" name="fgsystemreport">
        <field
            name="failed_login_days"
            type="text"
            filter="integer"
            default="7"
            label="COM_FGSYSTEMREPORT_CONFIG_FAILED_LOGIN_DAYS_LABEL"
            description="COM_FGSYSTEMREPORT_CONFIG_FAILED_LOGIN_DAYS_DESC"
        />
        <field
            name="failed_login_threshold"
            type="text"
            filter="integer"
            default="10"
            label="COM_FGSYSTEMREPORT_CONFIG_FAILED_LOGIN_THRESHOLD_LABEL"
            description="COM_FGSYSTEMREPORT_CONFIG_FAILED_LOGIN_THRESHOLD_DESC"
        />
        <field
            name="history_retention_days"
            type="text"
            filter="integer"
            default="365"
            label="COM_FGSYSTEMREPORT_CONFIG_HISTORY_RETENTION_LABEL"
            description="COM_FGSYSTEMREPORT_CONFIG_HISTORY_RETENTION_DESC"
        />
        <field
            name="probe_verify_tls"
            type="radio"
            layout="joomla.form.field.radio.switcher"
            default="0"
            filter="integer"
            label="COM_FGSYSTEMREPORT_CONFIG_PROBE_TLS_LABEL"
            description="COM_FGSYSTEMREPORT_CONFIG_PROBE_TLS_DESC"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="diskscan" label="COM_FGSYSTEMREPORT_CONFIG_DISKSCAN_FIELDSET" description="COM_FGSYSTEMREPORT_CONFIG_DISKSCAN_FIELDSET_DESC">
        <field name="disk_scan_max_items" type="text" filter="integer" default="500000"
            label="COM_FGSYSTEMREPORT_CONFIG_DISKSCAN_ITEMS_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_DISKSCAN_ITEMS_DESC" />
        <field name="disk_scan_time_limit" type="text" filter="integer" default="25"
            label="COM_FGSYSTEMREPORT_CONFIG_DISKSCAN_TIME_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_DISKSCAN_TIME_DESC" />
    </fieldset>

    <fieldset name="diskgrowth" label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_FIELDSET" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_FIELDSET_DESC">
        <field name="growth_alert_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_ENABLED_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_ENABLED_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="growth_alert_mb" type="text" filter="integer" default="100"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_MB_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_MB_DESC" />
        <field name="growth_alert_percent" type="text" filter="integer" default="25"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_PERCENT_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_PERCENT_DESC" />
        <field name="growth_alert_db_mb" type="text" filter="integer" default="50"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_DB_MB_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_DB_MB_DESC" />
        <field name="growth_alert_db_percent" type="text" filter="integer" default="25"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_DB_PERCENT_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_DB_PERCENT_DESC" />
        <field name="growth_alert_message" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_MESSAGE_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_MESSAGE_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="growth_alert_email" type="radio" layout="joomla.form.field.radio.switcher" default="0" filter="integer"
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_EMAIL_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_EMAIL_DESC">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="growth_alert_recipients" type="text" default=""
            label="COM_FGSYSTEMREPORT_CONFIG_GROWTH_RECIPIENTS_LABEL" description="COM_FGSYSTEMREPORT_CONFIG_GROWTH_RECIPIENTS_DESC" hint="admin@example.com, other@example.com" />
    </fieldset>

    <fieldset name="permissions" description="JCONFIG_PERMISSIONS_DESC" label="JCONFIG_PERMISSIONS_LABEL">
        <field name="rules" type="rules" component="com_fgsystemreport" class="inputbox" filter="rules" validate="rules" label="JCONFIG_PERMISSIONS_LABEL" section="component" />
	</fieldset>

    <fieldset name="component">
        <field
            name="save_history"
            type="radio"
            default="0"
            label="JGLOBAL_SAVE_HISTORY_OPTIONS_LABEL"
            description="JGLOBAL_SAVE_HISTORY_OPTIONS_DESC"
            layout="joomla.form.field.radio.switcher"
            >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="history_limit" type="text" filter="integer" label="JGLOBAL_HISTORY_LIMIT_OPTIONS_LABEL" description="JGLOBAL_HISTORY_LIMIT_OPTIONS_DESC" default="5"/>

      

        <field
          name="sef_ids"
          type="radio"
          layout="joomla.form.field.radio.switcher"
          default="0"
          label="JGLOBAL_SEF_NOIDS_LABEL"
          description="JGLOBAL_SEF_NOIDS_DESC"
          filter="integer"
          >
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
    </fieldset>
</config>
